{
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://afterbetting.com/:path*",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "www.afterbetting.com"
        }
      ]
    },
    {
      "source": "/blog/how-to-tell-someone-gambling-problem",
      "destination": "/blog/how-to-tell-family-about-gambling-problem",
      "permanent": true
    },
    {
      "source": "/blog/avalanche-debt-payoff-gambling",
      "destination": "/blog/snowball-debt-payoff-gambling",
      "permanent": true
    },
    {
      "source": "/blog/debt-free-after-gambling",
      "destination": "/blog/rebuild-finances-after-gambling",
      "permanent": true
    },
    {
      "source": "/blog/gambling-recovery-what-to-expect",
      "destination": "/blog/how-long-gambling-recovery-takes",
      "permanent": true
    },
    {
      "source": "/nl/blog/gokverslaving-herkennen",
      "destination": "/nl/blog/gokverslaving-symptomen-en-kenmerken",
      "permanent": true
    },
    {
      "source": "/onboarding",
      "destination": "https://app.afterbetting.com/onboarding",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "https://app.afterbetting.com/privacy",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "https://app.afterbetting.com/terms",
      "permanent": true
    },
    {
      "source": "/de",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/de/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/fr",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/fr/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/es",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/es/",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/nl/blog",
      "destination": "/nl/blog/index.html"
    },
    {
      "source": "/nl/blog/:slug",
      "destination": "/nl/blog/:slug.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug.html"
    },
    {
      "source": "/nl",
      "destination": "/nl/index.html"
    },
    {
      "source": "/de",
      "destination": "/de/index.html"
    },
    {
      "source": "/fr",
      "destination": "/fr/index.html"
    },
    {
      "source": "/es",
      "destination": "/es/index.html"
    },
    {
      "source": "/nl/about",
      "destination": "/nl/about.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "cleanUrls": true
}
